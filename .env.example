# Discord Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_test_server_guild_id_here

# Valorant API Configuration
HENRIK_API_KEY=your_henrik_api_key_here

# Development Mode
USE_MOCK_DATA=true

# Set false to use the stable match pipeline and skip beta career data.
ENABLE_EXPERIMENTAL_VALORANT_PIPELINE=true

# Local history for same-act party comparisons. Set false to stop collection.
ENABLE_MATCH_HISTORY=true
